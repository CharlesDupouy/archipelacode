{
  "name": "archipelacode",
  "displayName": "ArchipelaCode",
  "description": "Archipelago Multiworld Randomizer integration for LeetCode (Chrome Extension & APWorld)",
  "author": "ShackledMars261",
  "publisher": "ShackledMars261",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShackledMars261/archipelacode.git"
  },
  "scripts": {
    "compile": "webpack",
    "watch": "webpack --watch",
    "build:apworld": "python3 apworld/build_apworld.py",
    "package:extension": "webpack && python3 scripts/package_extension.py",
    "package:all": "npm run build:apworld && npm run package:extension",
    "lint": "eslint src",
    "test": "npx tsx src/test/pythonLexer.test.ts",
    "prepare": "husky install",
    "prettier": "prettier --check src",
    "prettier:fix": "prettier --write src"
  },
  "dependencies": {
    "archipelago.js": "^2.0.4"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "22.x",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "copy-webpack-plugin": "^14.0.0",
    "cspell": "^9.2.1",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^8.0.0",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.2.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "ts-loader": "^9.5.2",
    "typescript": "^5.9.2",
    "webpack": "^5.101.0",
    "webpack-cli": "^6.0.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,html,json}": [
      "prettier --write",
      "eslint"
    ],
    "*.{yaml,yml}": "prettier --write",
    "*.scss": "prettier --write",
    "*.md": "cspell --no-progress --color"
  },
  "cspell": {
    "ignorePaths": [
      "apworld/**"
    ],
    "dictionaries": [
      "ArchipelaCode Project"
    ],
    "dictionaryDefinitions": [
      {
        "name": "ArchipelaCode Project",
        "path": "./.cspell/project-dictionary.txt",
        "addWords": true
      }
    ]
  }
}
